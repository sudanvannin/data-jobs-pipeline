# Dockerfile customizado para Airflow com dependências do projeto
FROM apache/airflow:2.7.3-python3.11

USER root

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    wget \
    vim \
    git \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Instalar DBT como usuário airflow
RUN pip install --user dbt-core==1.6.7 dbt-postgres==1.6.7

# Copiar requirements customizados
COPY airflow/requirements.txt /tmp/requirements.txt

# Instalar dependências Python
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Copiar código do projeto
COPY --chown=airflow:root scraping/ /opt/airflow/scraping/
COPY --chown=airflow:root dbt/ /opt/airflow/dbt/

# Criar diretórios necessários
RUN mkdir -p /opt/airflow/logs /opt/airflow/plugins

# Configurar PYTHONPATH
ENV PYTHONPATH="${PYTHONPATH}:/opt/airflow/scraping"
